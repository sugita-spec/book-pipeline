    "start": "node server/index.mjs",
    "deploy": "npm run build && npx wrangler@4.127.1 deploy"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5"
  }
}
